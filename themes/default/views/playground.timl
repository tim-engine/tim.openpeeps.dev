style: """
  *, *::before, *::after { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; overflow: hidden; }
  body { background: #1e1e1e; display: flex; flex-direction: column; }

  .editor-header {
    background: #252526;
    border-bottom: 1px solid #3c3c3c;
    padding: 6px 16px;
    flex-shrink: 0;
  }

  .logo-img { height: 42px; width: auto; }
  .brand-text { font-size: 17px; font-weight: 700; color: #e0e0e0; letter-spacing: -0.3px; }
  .brand-sub { font-size: 11px; color: #888; }

  .panel-header {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #777;
    padding: 0 12px;
    background: #252526;
    border-bottom: 1px solid #3c3c3c;
    user-select: none;
    flex-shrink: 0;
  }

  #editor { width: 100%; height: 100%; font-size: 13.5px; }

  #console {
    background: #1a1a1a;
    font-family: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', 'SF Mono', monospace;
    font-size: 13px;
    line-height: 1.5;
    padding: 12px 14px;
    overflow-y: auto;
    overscroll-behavior: contain;
    white-space: pre-wrap;
    word-wrap: break-word;
    color: #c0c0c0;
    flex: 1 1 auto;
    min-height: 0;
  }

  .preview-wrap { min-height: 0; }

  #preview {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
    display: block;
  }

  .logs-panel {
    height: 30%;
    min-height: 140px;
    flex-shrink: 0;
    border-top: 1px solid #3c3c3c;
  }

  .console-line { display: flex; gap: 8px; }
  .console-prompt { color: #4ec9b0; flex-shrink: 0; }
  .console-output { color: #d4d4d4; }

  .toolbar-btn {
    background: #2d2d2d;
    border: 1px solid #3c3c3c;
    color: #ccc;
    padding: 3px 14px;
    border-radius: 4px;
    font-size: 12.5px;
    transition: all 0.12s;
    line-height: 1.6;
  }
  .toolbar-btn:hover {
    background: #3c3c3c;
    border-color: #4c4c4c;
    color: #fff;
  }
  .toolbar-btn.run-btn {
    background: #177a3a;
    border-color: #249c4e;
    color: #fff;
  }
  .toolbar-btn.run-btn:hover { background: #1f8f47; }

  #splitter {
    width: 4px;
    background: #2d2d2d;
    cursor: col-resize;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  #splitter:hover, #splitter.active { background: #4ec9b0; }

  .main-content.is-dragging #preview { pointer-events: none; }
  .main-content.is-dragging { user-select: none; }

  .output-panel { width: 780px; flex-shrink: 0; border-left: 1px solid #3c3c3c; }

  @media (max-width: 768px) {
    .main-content { flex-direction: column !important; }
    .output-panel { width: 100% !important; border-left: none !important; border-top: 1px solid #3c3c3c; }
    #editor { min-height: 50vh; }
    #preview { min-height: 40vh; }
    #htmlOut { min-height: 40vh; }
    .logs-panel { height: auto; }
    #console { min-height: 30vh; }
    #splitter { display: none; }
  }
  .auto-compile {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: #ccc;
    cursor: pointer;
    user-select: none;
    padding: 3px 6px;
  }
  .auto-compile input { accent-color: #249c4e; margin: 0; }
  .editor-bar { display: flex; align-items: center; gap: 14px; }
  .editor-bar .example-tabs {
    display: flex;
    gap: 2px;
    overflow-x: auto;
  }
  .example-tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #888;
    font-size: 1.5em;
    cursor: pointer;
    white-space: nowrap;
  }
  .example-tab:hover { color: #ccc; }
  .example-tab.active { color: #e0e0e0; border-bottom-color: #4ec9b0; }
  .output-bar { display: flex; align-items: center; gap: 14px; }
  .output-bar .example-tabs {
    display: flex;
    gap: 2px;
    overflow-x: auto;
  }
  #htmlOut {
    display: none;
    width: 100%;
    height: 100%;
    font-size: 12.5px;
  }
  #htmlOut.visible { display: block; }
  #preview.hidden { display: none; }
  .example-source { display: none; }
"""
const example1 = """

// read more about Tim macros
// https://tim.openpeeps.dev/language/macros
macro container() = div.container > @statement
macro row() = div.row > @statement

@static for $x in 1..12:
  macro col-lg-{$x} =
    div.col-lg-{$x} > @statement

html data-bs-theme="dark"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title: "Tim Engine is Awesome!"
    link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css"
  body
    @container > @row.vh-100.align-items-center > @col-lg-6.mx-auto.text-center
      h1.fw-bold: "Tim Engine is Awesome!"
      p: "Edit the template - output updates as you type."
      ul.list-inline
        for $item in ["views", "layouts", "partials"]:
          li: $item

    script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js"
"""

div.col-12 > div.card.mt-3.rounded-top-4.overflow-hidden
  div.editor-header.d-flex.align-items-center.justify-content-between.user-select-none
    div.d-flex.align-items-center.gap-2
      a.navbar-brand
        img src="https://raw.githubusercontent.com/tim-engine/tim/main/.github/timV2.png"
        em
      span.brand-text: "Tim Engine"
      span: "Playground"
      div.d-flex.mx-3.gap-3
        a data-no-spa href="https://tim.openpeeps.dev": "Documentation"
        a href="https://tim-engine.github.io/tim/theindex.html": "API Reference"
        a href="https://github.com/tim-engine/tim": "GitHub"
    div.d-flex.align-items-center.gap-2
      label.auto-compile
        input type="checkbox" id="autoCompile" checked="checked"
        " Auto-compile"
      label.auto-compile
        input type="checkbox" id="unminified"
        " Unminified"
      button#runBtn.btn.btn-danger.py-0.btn-sm.rounded-3: "Compile"
      button#clearBtn.btn.btn-secondary.py-0.btn-sm.rounded-3: "Clear"
  div.d-flex.flex-grow-1.overflow-hidden.main-content style="height:calc(100vh - 90px)"
    div.d-flex.flex-column.flex-grow-1.overflow-hidden
      div.panel-header.editor-bar
        div.example-tabs#exampleTabs
      div.flex-grow-1#editor
    div#splitter
    div.d-flex.flex-column.output-panel.overflow-hidden
      div.panel-header.output-bar
        div.example-tabs#outputTabs
          button.example-tab.active data-view="preview": "Preview"
          button.example-tab data-view="html": "HTML"
      div.flex-grow-1.overflow-hidden.preview-wrap
        iframe#preview sandbox="allow-scripts"
        div#htmlOut
      div.logs-panel.d-flex.flex-column.overflow-hidden
        div.panel-header: "Logs"
        div.flex-grow-1#console style="overflow:auto"

div#example1.example-source data-title="Basics": $example1